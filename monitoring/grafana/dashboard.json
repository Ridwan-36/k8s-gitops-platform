{
  "title": "Kubernetes Platform Overview",
  "uid": "platform-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Node CPU Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Node Memory Available",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "node_memory_MemAvailable_bytes", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (namespace,pod) (kube_pod_container_status_restarts_total)", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Scrape Target Status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "up", "refId": "A"}]
    }
  ]
}
